# ══════════════════════════════════════════════════
# EcoTwin Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ══════════════════════════════════════════════════

# ── Gemini API ──
GEMINI_API_KEY=your_gemini_api_key_here

# ── Security ──
# Auto-generated if empty. Set a fixed value for consistent token signing across restarts.
SECRET_KEY=
# Set to false in production (default: false)
DEBUG=false

# ── Admin Credentials ──
# Username for admin login
ADMIN_USERNAME=admin
# SHA-256 hash of admin password (salted with SECRET_KEY).
# Generate by running: python -c "from app.auth import hash_password; print(hash_password('your-password'))"
# Leave empty to disable admin login.
ADMIN_PASSWORD_HASH=

# ── Backend ──
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Comma-separated allowed origins for CORS
FRONTEND_ORIGIN=http://localhost:5173

# ── Database ──
DATABASE_URL=sqlite:///./ecotwin.db

# ── Seed ──
SEED_RANDOM=42

# ── Rate Limits ──
MAX_UPLOAD_SIZE_MB=5
DETECTION_RATE_LIMIT=30
RECOMMEND_RATE_LIMIT=10
