# Frontend environment variables
# Copy this file to .env and fill in values for your deployment.

# Backend API URL (required when hosting frontend separately from backend)
# Examples:
#   Render:  https://ecotwin-api.onrender.com
#   Railway: https://ecotwin-backend.up.railway.app
#   Custom:  https://api.yourdomain.com
#
# Leave blank or omit for local development (Vite proxy handles /api/* routing)
VITE_API_URL=
